# Copy to .env. Read once at the CLI entry point and passed down as RequestContext.
# Never read at module import time.
JFL_DATABASE_URL=postgresql+psycopg://jfl:jfl@localhost:5433/jfl
ANTHROPIC_API_KEY=
# Optional. Defaults to the seeded local user (0425d123-ed29-5a6a-a06d-d00267574046).
# JFL_USER_ID=
JFL_EMBEDDING_DEVICE=cuda   # cuda | cpu
# Optional. Model id for all model calls -- defaults to claude-opus-5.
# JFL_MODEL=claude-opus-5   # claude-opus-5 | claude-sonnet-5
