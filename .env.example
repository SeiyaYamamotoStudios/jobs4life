# Copy to .env. Read once at the CLI entry point and passed down as RequestContext.
# Never read at module import time.
JFL_DATABASE_URL=postgresql+psycopg://jfl:jfl@localhost:5433/jfl
ANTHROPIC_API_KEY=
# Optional. Defaults to the seeded local user (0425d123-ed29-5a6a-a06d-d00267574046).
# JFL_USER_ID=
JFL_EMBEDDING_DEVICE=cuda   # cuda | cpu
# Optional. Model id for product calls (extraction, coverage, scoring, drafting,
# answers) -- defaults to claude-opus-5-5. The cheap calls (title suggestions,
# capability grouping, profile suggestions, pushback reading) always use Haiku.
# JFL_MODEL=claude-opus-5-5   # claude-opus-5-5 | claude-opus-5 | claude-sonnet-5
# Optional. Model id for the claim gate alone -- defaults to claude-opus-5,
# because the published over-claim / over-flag rates were measured on it.
# Changing JFL_MODEL never moves the gate; only this does.
# JFL_GATE_MODEL=claude-opus-5
# Optional, and only for publishing the demo page (D3). Cloudflare API token
# scoped to Pages:Edit -- NOT an account-wide token. Used by
#   npx wrangler pages deploy demo/site --project-name=jobs4life
# Nothing in packages/ ever reads this; it is a deploy credential, not a
# RequestContext one, and must never reach the runs table or a trace.
# CLOUDFLARE_API_TOKEN=
# Required alongside it: a Pages:Edit-scoped token cannot enumerate accounts, so
# wrangler cannot discover this on its own. Not a secret -- it appears in every
# dashboard URL (dash.cloudflare.com/<account-id>/...) and on any domain's
# Overview page in the right-hand sidebar.
# CLOUDFLARE_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Web app (packages/web). Read once by WebSettings.from_env() at startup and
# passed down -- no module below it touches the environment. A missing value
# stops the process at boot rather than at the first user who hits that path.
# ---------------------------------------------------------------------------

# Credential custody (A4). The key-encryption key: 32 bytes, base64. It is NEVER
# stored in Postgres, so a database compromise on its own yields nothing usable,
# and it is NEVER generated automatically -- a fresh key would silently orphan
# every credential already stored. Generate one once and keep it safe:
#   openssl rand -base64 32
JFL_MASTER_KEY=

# Google OAuth (A1). Create an OAuth 2.0 Client ID (type "Web application") in
# the Google Cloud console. Scopes are fixed in code at `openid email profile`
# and no Gmail scope is ever requested -- restricted scopes need an annual CASA
# security assessment, and email intake is a dedicated forwarding address.
# The redirect URI must match the console entry exactly.
JFL_GOOGLE_CLIENT_ID=
JFL_GOOGLE_CLIENT_SECRET=
JFL_GOOGLE_REDIRECT_URI=https://app-jobs4life.hiltonlabs.org/auth/google/callback

# Signs the short-lived cookie holding the OAuth `state` and PKCE verifier
# (seconds, not sessions). The login session itself is an opaque id in Postgres,
# not a signed token, so rotating this only interrupts logins in flight.
#   openssl rand -base64 32
JFL_OAUTH_STATE_SECRET=

# Optional. Rolling session lifetime; default 336 (14 days).
# JFL_SESSION_TTL_HOURS=336

# Optional. `__Host-` cookies require Secure, which requires HTTPS, so plain
# http://localhost cannot use them. Setting this drops the prefix and the Secure
# flag and logs a warning at startup. LOCAL DEVELOPMENT ONLY -- never deployed.
# JFL_INSECURE_COOKIES=1

# Optional, default on. Checks a submitted API key with one GET /v1/models call
# so a typo fails at the form. The call costs nothing (no tokens either way).
# JFL_VALIDATE_API_KEYS=0

# --- background worker (slice B1) -------------------------------------------
# The kill switch. Any value other than 0/false/no/off turns it ON, and the
# worker then refuses every task whose handler is marked as calling a model,
# leaving it `pending` rather than failed -- so nothing is lost when it goes
# back off. This is the incident response if a key starts burning money; the
# other half is stopping the worker container, which leaves the site running.
# JFL_DISABLE_MODEL_CALLS=0
# Seconds before a task stuck in `running` (worker killed mid-task) is
# reclaimable. Must exceed the slowest task -- a claim-gate call is ~2 minutes --
# because reclaiming early runs the work, and pays for it, twice.
# JFL_WORKER_VISIBILITY_TIMEOUT=900
# JFL_WORKER_POLL_INTERVAL=2

