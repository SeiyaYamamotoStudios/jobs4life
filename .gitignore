.venv/
__pycache__/
*.py[cod]
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
logs/
dist/

# The corpus is real career detail and this repo is public. The database is a
# rebuildable index over these files, so losing them loses the source of truth --
# back them up somewhere private rather than relying on this repo.
corpus/*
!corpus/.gitkeep

# Drift analyses quote real career detail and boundaries. Same reasoning as
# corpus/: this repo is not where that lives, even while private.
analysis/*
!analysis/.gitkeep

# Wrangler's local deploy cache, not source.
.wrangler/
.env.*
!.env.example

# Agent worktrees
.claude/worktrees/
